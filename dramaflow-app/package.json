{
  "name": "dramaflow-app",
  "version": "1.0.0",
  "description": "AI 短剧生成提效工具：剧本创作、分镜生成、角色管理、场景配音、视频合成一站式工作流",
  "author": "DramaFlow",
  "license": "AGPL-3.0",
  "keywords": [
    "ai",
    "short-drama",
    "storyboard",
    "tts",
    "video",
    "react",
    "electron"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:desktop": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build:electron": "tsc -p tsconfig.electron.json",
    "smoke:synthesis": "tsc -p tsconfig.electron.json && node scripts/synthesis-smoke-test.js"
  },
  "build": {
    "appId": "com.dramaflow.app",
    "productName": "DramaFlow",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "executableName": "DramaFlow"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wait-on": "^8.0.0"
  }
}
